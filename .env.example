# Base RPC endpoint (from docs.retium.org/developers/wire-reference.html)
RETIUM_RPC_BASE=https://rpc.retium.org

# Reads (GET /api/wallet/*) are open and need no key.
# Only needed if you later add write calls (sends, deploys, etc.)
# RETIUM_API_KEY=rk_...

# Optional: port for the local server
PORT=3000

# Optional, undocumented indexer base for tx history / wallet age.
# Leave unset until you have real endpoint paths — see src/explorer.js
# RETIUM_EXPLORER_BASE=
